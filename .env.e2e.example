# Copy to .env.e2e.local (git-ignored) and fill in a THROW-AWAY test account. Never a real person's.
# Then:  set -a; source .env.e2e.local; set +a; npm run test:e2e
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
# Two-account handover test (e2e/handover.spec.ts):
E2E_HOST_EMAIL=
E2E_HOST_PASSWORD=
E2E_RENTER_EMAIL=
E2E_RENTER_PASSWORD=
E2E_BOOKING_ID=
