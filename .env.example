# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (see the `*.local` rule in .gitignore) — never
# commit real keys.

# Supabase project URL and anon/public key, from Settings -> API in your
# Supabase project dashboard. Both are safe to expose client-side.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
