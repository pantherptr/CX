# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (see the `*.local` rule in .gitignore) — never
# commit real keys.

# Supabase project URL and anon/public key, from Settings -> API in your
# Supabase project dashboard. Both are safe to expose client-side (also
# read directly, without the VITE_ prefix, by the api/*.ts serverless
# functions — VITE_ only controls what Vite inlines into the browser
# bundle, it doesn't hide the variable from server-side code).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Native iOS app (see capacitor.config.ts, src/lib/api.ts) ---

# Base URL the native app's fetch calls to our own /api/* functions are
# prefixed with (see src/lib/api.ts's apiUrl()). Leave this BLANK for the
# plain web build — the site and its /api/* functions share an origin
# there, so a relative path is already correct.
#
# The native iOS shell is different: Capacitor serves the bundled app from
# its own internal origin, not from this deployment's real domain, so a
# relative fetch('/api/...') would 404 inside the app. Before building the
# web bundle that ships inside the iOS app, set this to your deployed
# origin with no trailing slash, e.g.:
#   VITE_API_BASE_URL=https://cxrent.vercel.app npm run build
# for a production TestFlight/App Store build, or your preview deployment's
# URL for a staging build — then run `npx cap sync ios`. api/_lib/cors.ts
# is what allows the native app's cross-origin requests through.
VITE_API_BASE_URL=

# --- Push notifications (iOS/APNs — see api/_lib/push.ts, src/lib/push.ts,
# supabase/migrations/0020_push_device_tokens.sql) ---
#
# All four required together, or push is skipped with a console warning —
# the same graceful-skip pattern RESEND_API_KEY uses above. These only
# exist once you have a paid Apple Developer account; see the iOS
# runbook's "Apple-account boundary" for where to generate them.

# From the Apple Developer portal -> Certificates, Identifiers & Profiles
# -> Keys -> your "Apple Push Notifications service" key.
APNS_KEY_ID=
# Apple Developer portal -> Membership -> Team ID.
APNS_TEAM_ID=
# The full contents of the downloaded AuthKey_XXXXXXXXXX.p8 file,
# including the -----BEGIN/END PRIVATE KEY----- lines. Paste it as-is (a
# real multi-line PEM) into Vercel's env var value — escaped "\n" also
# works, api/_lib/push.ts unescapes it either way.
APNS_PRIVATE_KEY=
# Must exactly match the app's real bundle identifier — the same value
# capacitor.config.ts's appId is set to once it's no longer the
# com.cxrent.app placeholder.
APNS_BUNDLE_ID=
# "sandbox" while testing an app installed via Xcode/TestFlight-internal
# without going through App Review; "production" (the default if unset)
# once the app is live, including regular TestFlight external builds.
APNS_ENVIRONMENT=

# --- Stripe (real payments — see api/create-payment-intent.ts and
# api/stripe-webhook.ts) ---

# Publishable key (pk_test_... / pk_live_...), from the Stripe dashboard
# under Developers -> API keys. Safe to expose client-side.
VITE_STRIPE_PUBLISHABLE_KEY=

# Secret key (sk_test_... / sk_live_...), same page. SERVER-SIDE ONLY —
# never prefix this with VITE_, or it would end up in the browser bundle.
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_...). In production this comes from the
# webhook endpoint you create in the Stripe dashboard (Developers ->
# Webhooks), pointed at https://<your-domain>/api/stripe-webhook,
# subscribed at least to payment_intent.succeeded. For local development
# with `vercel dev`, run `stripe listen --forward-to
# localhost:3000/api/stripe-webhook` (Stripe CLI) and use the secret it
# prints instead.
STRIPE_WEBHOOK_SECRET=

# Supabase service role key (Settings -> API -> service_role), used by
# api/stripe-webhook.ts to insert the real booking after a payment
# succeeds (bypassing RLS) and by both that file and
# api/send-pickup-reminders.ts to look up a renter's/host's email via
# supabase.auth.admin.getUserById. SERVER-SIDE ONLY — this key can read
# and write everything in the database; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (booking confirmations + pickup/return reminders — see
# api/_lib/email.ts, api/stripe-webhook.ts, api/send-pickup-reminders.ts) ---

# Resend API key (resend.com -> API Keys). Without one set, emails are
# skipped with a console warning rather than failing anything — useful
# while you're still setting this up.
RESEND_API_KEY=

# "Name <address>" to send from. Resend's shared sandbox address
# (onboarding@resend.dev, the default if this is left blank) works with
# zero setup but only delivers to the address that owns the API key —
# verify your own domain in Resend and put a real address here before
# sending to real renters/hosts.
RESEND_FROM_EMAIL=Velora <onboarding@resend.dev>

# Used to build links inside emails (e.g. "View my trip"). Set this to
# your deployed URL, e.g. https://velora.vercel.app.
SITE_URL=

# Shared secret for api/send-pickup-reminders.ts — set the same value
# here and as a Vercel project env var, and Vercel Cron sends it
# automatically as `Authorization: Bearer <value>` on every scheduled
# call (see the `crons` entry in vercel.json). Without it set, the
# endpoint is unauthenticated — fine for a first local test, not for
# production.
CRON_SECRET=

# --- Security deposit (see supabase/migrations/0019_security_deposit.sql,
# api/create-payment-intent.ts, api/stripe-webhook.ts) ---
#
# No new env vars — the deposit hold reuses the same STRIPE_SECRET_KEY /
# STRIPE_WEBHOOK_SECRET above. It's a Stripe *authorization hold*
# (capture_method: 'manual'), not a charge: placed on the renter's card
# right after their booking payment succeeds, using the payment method
# Stripe already saved for that PaymentIntent, and released automatically
# by the api/send-pickup-reminders.ts daily sweep the day after the trip
# ends (see vercel.json's `crons` entry — must be enabled for deposits to
# ever release).
#
# Caveat worth knowing about: card networks generally let an
# uncaptured authorization hold expire after about 7 days. For rentals
# longer than that, the hold could lapse before the trip even ends — this
# is a known limitation, not a bug; a future improvement would be
# re-authorizing the hold partway through long trips.
